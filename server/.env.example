# Email Configuration using Resend (Recommended for public/production use)
# Get your free API key at https://resend.com

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Custom from address (after you verify a domain in Resend)
FROM_EMAIL=PrepPro <no-reply@yourdomain.com>

# ============================================
# Alternative: SMTP (Nodemailer) - Not recommended for public apps
# Only use if you really want to use Gmail/Outlook SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=your@gmail.com
